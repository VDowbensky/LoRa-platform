//        <7=> 7: V20 = Set threshold to 2.0 V
//        <8=> 8: V21 = Set threshold to 2.1 V
//        <9=> 9: V22 = Set threshold to 2.2 V
//        <10=> 10: V23 = Set threshold to 2.3 V
//        <11=> 11: V24 = Set threshold to 2.4 V
//        <12=> 12: V25 = Set threshold to 2.5 V
//        <13=> 13: V26 = Set threshold to 2.6 V
//        <14=> 14: V27 = Set threshold to 2.7 V
//        <15=> 15: V28 = Set threshold to 2.8 V
//    </combo>
